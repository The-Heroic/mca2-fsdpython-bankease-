        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Start([Customer Initiates Funds Transfer]) --&gt; SelectSource[/Select Source Account/]\n    SelectSource --&gt; BenCheck{Is Beneficiary Registered?}\n    \n    BenCheck -- No --&gt; AddBen[/Enter Payee Name, Account No., &amp; IFSC/]\n    AddBen --&gt; VerifyIFSC{Valid IFSC &amp; Account Format?}\n    VerifyIFSC -- No --&gt; AddBen\n    VerifyIFSC -- Yes --&gt; SaveBen[Save Payee &amp; Start Cooling Period]\n    SaveBen --&gt; CoolWait([Wait Cooling Period / Activate Payee])\n    \n    BenCheck -- Yes --&gt; CoolCheck{Cooling Period Complete?}\n    CoolCheck -- No --&gt; CoolWait\n    CoolCheck -- Yes --&gt; EnterDetails[/Select NEFT/IMPS/RTGS &amp; Enter INR Amount/]\n    \n    EnterDetails --&gt; ValidateTx{Active Account, Sufficient Balance &amp; Within Daily Limit?}\n    ValidateTx -- No --&gt; TxReject([Reject Transfer &amp; Log Failed Attempt])\n    \n    ValidateTx -- Yes --&gt; TxOTP[/Enter Transaction PIN / OTP/]\n    TxOTP --&gt; PinCheck{Valid PIN/OTP?}\n    PinCheck -- No --&gt; TxReject\n    \n    PinCheck -- Yes --&gt; AtomicStart[Start Django ORM Atomic Transaction]\n    AtomicStart --&gt; DebitSrc[Debit Sender Account Balance]\n    DebitSrc --&gt; CreditDest[Credit Beneficiary / Record Outward Clearing]\n    CreditDest --&gt;GenRef[Create Ledger Entry &amp; Unique UTR Reference]\n    GenRef --&gt; CommitTx([Commit DB Transaction &amp; Generate Receipt])&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="SfHvbvB0CV9nXtI6pEhV-1">
