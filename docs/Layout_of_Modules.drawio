        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Start([Customer Opens Bill Payment Portal]) --&gt; BillerCheck{Biller Already Linked?}\n    \n    BillerCheck -- No --&gt; SelectCat[/Select Category: Electricity, Water, DTH, Broadband, Credit Card/]\n    SelectCat --&gt; AddBiller[/Enter Consumer ID / Biller Account Number/]\n    AddBiller --&gt; SaveBiller[Save Registered Biller to Customer Profile]\n    SaveBiller --&gt; FetchBill\n    \n    BillerCheck -- Yes --&gt; FetchBill[Fetch Pending Bill Amount &amp; Due Date]\n    FetchBill --&gt; PayMode{Manual Pay or Auto-Pay?}\n    \n    PayMode -- Setup Auto-Pay --&gt; ConfigAuto[/Set Max Auto-Debit Limit &amp; Schedule/]\n    ConfigAuto --&gt; WaitDue[Cron/Scheduler Triggers on Due Date]\n    WaitDue --&gt; BalVerify\n    \n    PayMode -- Pay Now --&gt; ConfirmAmt[/Confirm Bill Amount &amp; Source Account/]\n    ConfirmAmt --&gt; BalVerify{Sufficient Account Balance?}\n    \n    BalVerify -- No --&gt; FailBill([Mark Payment Failed &amp; Send Low-Balance Alert])\n    BalVerify -- Yes --&gt; DebitBill[Atomic Debit from Customer Account]\n    DebitBill --&gt; UpdateBill[Mark Bill Status: PAID &amp; Generate BBPS Receipt]\n    UpdateBill --&gt; EndBill([Save to Bill Payment History])&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="rdPlATgwzEoXuuuxeGM1-1">
