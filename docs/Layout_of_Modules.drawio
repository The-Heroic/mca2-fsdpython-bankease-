  <diagram id="swY2wEWBdmZkpvOv8Uso" name="Module 2: Account Management">
    <mxGraphModel dx="1030" dy="626" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Start([Customer Enters Account Module]) --&gt; HasAcc{Has Active Bank Account?}\n    \n    HasAcc -- No --&gt; ApplyAcc[/Select Savings/Current &amp; Upload KYC Docs/]\n    ApplyAcc --&gt; OfficerQueue[(Pending Officer Verification)]\n    OfficerQueue --&gt; OffReview{Bank Officer Reviews KYC}\n    \n    OffReview -- Rejected --&gt; NotifyRej[Update Status: Rejected &amp; Notify Customer]\n    NotifyRej --&gt; ApplyAcc\n    \n    OffReview -- Approved --&gt; GenAcc[Generate 12-Digit Account No. &amp; IFSC Mapping]\n    GenAcc --&gt; ActivateAcc[Set Account Status: ACTIVE]\n    ActivateAcc --&gt; AccMenu\n    \n    HasAcc -- Yes --&gt; AccMenu{Select Account Operation}\n    AccMenu -- View Summary --&gt; ViewBal[Fetch Real-Time Balance &amp; Account Details]\n    AccMenu -- Statements --&gt; FilterTx[/Select Date Range &amp; Transaction Type/]\n    FilterTx --&gt; ExportStmt[Render Statement &amp; Download PDF/CSV]\n    AccMenu -- Account Control --&gt; StatusReq[/Request Freeze / Unfreeze / Closure/]\n    StatusReq --&gt; OffApprove[Bank Officer Updates Account Status]\n    \n    ViewBal --&gt; EndNode([Return to Account Overview])\n    ExportStmt --&gt; EndNode\n    OffApprove --&gt; EndNode&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Iu8Fymx3pdT6N3lv3xau-1">
