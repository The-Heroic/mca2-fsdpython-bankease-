  <diagram id="bYEeYbosDq-NER_edRUT" name="Module 1: User Authentication">
    <mxGraphModel dx="1493" dy="907" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Start([User Opens Auth Screen]) --&gt; Choice{New or Existing User?}\n    \n    Choice -- New Customer --&gt; RegForm[/Submit Registration &amp; KYC Details/]\n    RegForm --&gt; HashPass[Hash Password &amp; Create User Record]\n    HashPass --&gt; AssignRole[Assign &#39;Customer&#39; Role &amp; Status: Pending KYC]\n    AssignRole --&gt; LoginForm\n    \n    Choice -- Existing User --&gt; LoginForm[/Enter Email/Username &amp; Password/]\n    LoginForm --&gt; VerifyCred{Valid Credentials?}\n    \n    VerifyCred -- No --&gt; IncFail[Increment Failed Attempts &amp; Log IP]\n    IncFail --&gt; CheckLock{Attempts &gt;= 3?}\n    CheckLock -- Yes --&gt; LockAcc([Lock Account &amp; Trigger Security Alert])\n    CheckLock -- No --&gt; LoginForm\n    \n    VerifyCred -- Yes --&gt; SendOTP[Generate &amp; Send 6-Digit OTP]\n    SendOTP --&gt; VerifyOTP{OTP Valid &amp; Not Expired?}\n    VerifyOTP -- No --&gt; LoginForm\n    VerifyOTP -- Yes --&gt; IssueJWT[Issue Access &amp; Refresh JWT Tokens]\n    \n    IssueJWT --&gt; RoleRoute{Check User Role}\n    RoleRoute -- Customer --&gt; CustPortal([Redirect to Customer Dashboard])\n    RoleRoute -- Bank Officer --&gt; OffPortal([Redirect to Officer Dashboard])\n    RoleRoute -- Admin --&gt; AdminPortal([Redirect to Admin Console])&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ogh5L68vb9Tvhsxq33O2-1">
