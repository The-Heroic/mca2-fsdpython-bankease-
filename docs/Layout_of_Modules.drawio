  <diagram id="HZet7YvMz1f3bfgF745P" name="Module 8: Security and Compliance">
    <mxGraphModel dx="1030" dy="626" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Start([Incoming API Request / Banking Event]) --&gt; AuthMiddleware{Valid JWT &amp; Role Permission?}\n    \n    AuthMiddleware -- No --&gt; LogUnauth[Record Unauthorized Access Attempt, IP &amp; User-Agent]\n    LogUnauth --&gt; BlockReq([Return HTTP 401/403 &amp; Alert Security])\n    \n    AuthMiddleware -- Yes --&gt; ExecEvent[Process Banking Action]\n    ExecEvent --&gt; AuditLog[Write Immutable Entry to security_audit_logs Table]\n    \n    AuditLog --&gt; RuleEngine{Check Compliance &amp; Fraud Rules}\n    RuleEngine -- High-Value Tx &gt; Threshold --&gt; FlagTx[Flag Transaction for Compliance Review]\n    RuleEngine -- Rapid Multiple Failed PINs --&gt; FlagUser[Temporarily Freeze Account / Token]\n    RuleEngine -- Normal Activity --&gt; PassComp([Complete Request Normally])\n    \n    FlagTx --&gt; AdminQueue[(Admin / Compliance Officer Queue)]\n    FlagUser --&gt; AdminQueue\n    \n    AdminQueue --&gt; AdminInspect[/Admin Inspects Audit Trail &amp; KYC Compliance Status/]\n    AdminInspect --&gt; AdminAct{Is Activity Legitimate?}\n    AdminAct -- Yes --&gt; ClearFlag([Clear Flag &amp; Restore Normal Access])\n    AdminAct -- No --&gt; EnforceLock([Enforce Account Freeze &amp; Generate Compliance Report])&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="uK5YiW-bpX_Ow0Iy71hZ-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
