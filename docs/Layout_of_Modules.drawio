<mxfile host="Electron" pageGroups="1" pages="15">
  <diagram name="Functional User Flowchart" id="Mlx2zhTW9xK353FHJ7hS">
    <mxGraphModel dx="3121" dy="1897" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Start &amp; Module 1: User Authentication\n    Start([Start: User Visits BankEase React Portal]) --&gt; Login[/Enter Credentials &amp; OTP / JWT Login/]\n    Login --&gt; AuthCheck{Module 1: Valid Credentials?}\n    \n    AuthCheck -- No --&gt; SecFail[Module 8: Log Failed Login &amp; IP in Audit Trail]\n    SecFail --&gt; LockCheck{Attempts &gt; 3?}\n    LockCheck -- Yes --&gt; LockAcc[Lock Account &amp; Send Security Alert]\n    LockCheck -- No --&gt; Login\n    \n    AuthCheck -- Yes --&gt; SecPass[Module 8: Record Login Session &amp; Audit Log]\n    SecPass --&gt; RoleCheck{Check User Role}\n\n    %% ==========================================\n    %% BRANCH 1: CUSTOMER WORKFLOW\n    %% ==========================================\n    RoleCheck -- Customer --&gt; CustDash[Module 10: Customer Dashboard &amp; Financial Analytics]\n    \n    CustDash --&gt; CustAction{Select Banking Service}\n    \n    %% Module 2: Account Management\n    CustAction -- Accounts --&gt; AccMgmt[Module 2: View Balance, KYC Status &amp; Statements]\n    AccMgmt --&gt; CustDash\n    \n    %% Module 3: Funds Transfer\n    CustAction -- Funds Transfer --&gt; BenCheck{Module 3: Payee Registered &amp; Active?}\n    BenCheck -- No --&gt; AddBen[Add Beneficiary &amp; Wait Cooling Period]\n    AddBen --&gt; CustDash\n    BenCheck -- Yes --&gt; BalCheck{Sufficient Balance &amp; Within Limit?}\n    BalCheck -- No --&gt; TxFail[Reject Transfer &amp; Show Error]\n    TxFail --&gt; CustDash\n    BalCheck -- Yes --&gt; ExecTx[Execute Atomic Debit/Credit via NEFT/IMPS/RTGS]\n    ExecTx --&gt; NotifyNode\n    \n    %% Module 4: Bill Payment\n    CustAction -- Bill Payment --&gt; BillPay[Module 4: Select Biller / Auto-Pay &amp; Pay Utility Bill]\n    BillPay --&gt; NotifyNode\n    \n    %% Module 5: Loan Management (Customer Side)\n    CustAction -- Loans --&gt; LoanAct[Module 5: Calculate EMI &amp; Submit Loan Application]\n    LoanAct --&gt; LoanQueue[(Pending Loan Applications)]\n    LoanQueue --&gt; NotifyNode\n    \n    %% Module 6: Investment Services\n    CustAction -- Investments --&gt; InvAct[Module 6: Open/Manage FD, RD or Portfolio]\n    InvAct --&gt; NotifyNode\n    \n    %% Module 7: Customer Support (Customer Side)\n    CustAction -- Support --&gt; SupAct[Module 7: Raise Support Ticket &amp; Track Status]\n    SupAct --&gt; TicketQueue[(Active Support Tickets)]\n    TicketQueue --&gt; NotifyNode\n\n    %% ==========================================\n    %% BRANCH 2: BANK OFFICER WORKFLOW\n    %% ==========================================\n    RoleCheck -- Bank Officer --&gt; OffDash[Module 10: Bank Officer Operational Dashboard]\n    \n    OffDash --&gt; OffAction{Select Officer Task}\n    \n    OffAction -- KYC &amp; Accounts --&gt; KYCVerify[Module 2 &amp; 8: Verify Customer KYC &amp; Approve/Freeze Account]\n    KYCVerify --&gt; NotifyNode\n    \n    OffAction -- Loan Review --&gt; LoanRev[Module 5: Review Credit, Verify Docs &amp; Approve/Reject Loan]\n    LoanQueue -.-&gt; LoanRev\n    LoanRev --&gt; NotifyNode\n    \n    OffAction -- Support Tickets --&gt; TicketRes[Module 7: Respond to Customer Ticket &amp; Mark Resolved]\n    TicketQueue -.-&gt; TicketRes\n    TicketRes --&gt; NotifyNode\n\n    %% ==========================================\n    %% BRANCH 3: ADMIN WORKFLOW\n    %% ==========================================\n    RoleCheck -- Admin --&gt; AdminDash[Module 10: Admin System &amp; Compliance Dashboard]\n    \n    AdminDash --&gt; AdminAction{Select Admin Task}\n    AdminAction -- Manage Roles --&gt; RoleMgmt[Module 1: Manage Users, Officers &amp; Role Permissions]\n    AdminAction -- Audit &amp; Compliance --&gt; AuditRev[Module 8: Inspect Security Logs &amp; Flagged Transactions]\n    AdminAction -- System Reports --&gt; SysRep[Module 10: Generate Bank-Wide Financial Reports]\n    \n    RoleMgmt --&gt; EndSession\n    AuditRev --&gt; EndSession\n    SysRep --&gt; EndSession\n\n    %% ==========================================\n    %% SHARED: MODULE 9 (NOTIFICATIONS) &amp; LOGOUT\n    %% ==========================================\n    NotifyNode[Module 9: Trigger Real-Time Alert / Notification &amp; Update DB] --&gt; MoreAct{Continue Banking?}\n    MoreAct -- Yes --&gt; RoleCheck\n    MoreAct -- No --&gt; EndSession[Invalidate JWT Token &amp; Log Logout]\n    LockAcc --&gt; Stop([End Session])\n    EndSession --&gt; Stop&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="82gsOhEZPVirrM5GX82O-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
