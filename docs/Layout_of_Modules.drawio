        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Start([Customer Opens Investment Services]) --&gt; SelectProd{Select Investment Product}\n    \n    SelectProd -- Fixed Deposit FD --&gt; FDInput[/Enter Principal Amount, Tenure &amp; Interest Payout Mode/]\n    SelectProd -- Recurring Deposit RD --&gt; RDInput[/Enter Monthly Installment &amp; Tenure/]\n    SelectProd -- Wealth / Mutual Fund --&gt; MFInput[/Select Fund Scheme &amp; Investment Amount/]\n    \n    FDInput --&gt; CalcMat[Calculate Maturity Amount &amp; Maturity Date]\n    RDInput --&gt; CalcMat\n    MFInput --&gt; CalcMat\n    \n    CalcMat --&gt; CheckFunds{Sufficient Balance in Linked Account?}\n    CheckFunds -- No --&gt; Insufficient([Cancel Request: Insufficient Funds])\n    \n    CheckFunds -- Yes --&gt; DebitInv[Debit Customer Account &amp; Issue Investment Certificate]\n    DebitInv --&gt; ActiveInv[Set Investment Status: ACTIVE]\n    \n    ActiveInv --&gt; Lifecycle{Maturity Reached or Premature Withdrawal?}\n    Lifecycle -- Premature Close --&gt; CalcPenalty[Apply Premature Penalty Rate on Accrued Interest]\n    CalcPenalty --&gt; Payout\n    \n    Lifecycle -- Full Maturity --&gt; CalcFull[Calculate Full Principal + Accrued Returns]\n    CalcFull --&gt; Payout[Credit Total Payout to Linked Bank Account]\n    Payout --&gt; CloseInv([Mark Investment Status: MATURED / CLOSED])&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="oUa9ag6GE5tpnKyB0dGL-1">
