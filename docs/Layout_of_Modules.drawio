        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    subgraph M1 [\&quot;Module 1: User Authentication\&quot;]\n        M1_A[Register / Login] --&gt; M1_B{Valid + OTP?}\n        M1_B -- Yes --&gt; M1_C[Issue JWT &amp; Route by Role]\n        M1_B -- No --&gt; M1_D[Log Failure / Lock Account]\n    end\n\n    subgraph M2 [\&quot;Module 2: Account Management\&quot;]\n        M2_A[Apply Account &amp; KYC] --&gt; M2_B{Officer KYC Check}\n        M2_B -- Approved --&gt; M2_C[Active Account: Balance &amp; Statements]\n        M2_B -- Freeze/Close --&gt; M2_D[Update Account Status]\n    end\n\n    subgraph M3 [\&quot;Module 3: Funds Transfer\&quot;]\n        M3_A[Add/Select Beneficiary] --&gt; M3_B{Balance &amp; Limit OK?}\n        M3_B -- Yes --&gt; M3_C[Atomic Debit/Credit &amp; UTR Receipt]\n        M3_B -- No --&gt; M3_D[Reject Transfer]\n    end\n\n    subgraph M4 [\&quot;Module 4: Bill Payment\&quot;]\n        M4_A[Link Biller / Auto-Pay] --&gt; M4_B[Fetch Utility Bill]\n        M4_B --&gt; M4_C{Sufficient Funds?}\n        M4_C -- Yes --&gt; M4_D[Pay Bill &amp; Generate Receipt]\n    end\n\n    subgraph M5 [\&quot;Module 5: Loan Management\&quot;]\n        M5_A[EMI Calc &amp; Loan Apply] --&gt; M5_B{Officer Credit Review}\n        M5_B -- Approved --&gt; M5_C[Disburse Loan &amp; Track Monthly EMIs]\n        M5_B -- Rejected --&gt; M5_D[Notify Rejection]\n    end\n\n    subgraph M6 [\&quot;Module 6: Investment Services\&quot;]\n        M6_A[Select FD / RD / Portfolio] --&gt; M6_B[Debit Account &amp; Issue Certificate]\n        M6_B --&gt; M6_C[Track Interest &amp; Maturity Payout]\n    end\n\n    subgraph M7 [\&quot;Module 7: Customer Support\&quot;]\n        M7_A[Customer Raises Ticket] --&gt; M7_B[Officer Investigates &amp; Replies]\n        M7_B --&gt; M7_C[Mark Resolved &amp; Close Ticket]\n    end\n\n    subgraph M8 [\&quot;Module 8: Security &amp; Compliance\&quot;]\n        M8_A[Monitor API &amp; Auth Events] --&gt; M8_B[Write Immutable Audit Log]\n        M8_B --&gt; M8_C{Suspicious / High Value?}\n        M8_C -- Yes --&gt; M8_D[Flag for Admin Compliance Review]\n    end\n\n    subgraph M9 [\&quot;Module 9: Notifications &amp; Alerts\&quot;]\n        M9_A[Capture Banking Event] --&gt; M9_B[Classify: Tx / Security / Reminder]\n        M9_B --&gt; M9_C[Push Alert &amp; Track Read/Unread State]\n    end\n\n    subgraph M10 [\&quot;Module 10: Dashboard &amp; Reporting\&quot;]\n        M10_A[Role-Based Aggregation] --&gt; M10_B[Render KPI Cards &amp; Charts]\n        M10_B --&gt; M10_C[Export Filtered PDF / CSV Reports]\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="0oQj0Nbkr96Hd0ARg9dI-1">
